# Salin menjadi .env (jangan di-commit)

# Lokal tanpa Postgres:
DATABASE_URL=sqlite:///./literasy_dev.db
# Produksi (Supabase/Neon), contoh:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CREATE_TABLES_ON_STARTUP=true

# Produksi: tutup /docs dan /openapi.json
DOCS_ENABLED=true

# Sesi login (hari, diperpanjang setiap dipakai) & pembatasan percobaan login
SESSION_TTL_DAYS=30
LOGIN_WINDOW_MINUTES=15
LOGIN_MAX_FAILURES_PER_USER=5
LOGIN_MAX_FAILURES_PER_IP=30
